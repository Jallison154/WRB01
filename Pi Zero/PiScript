    # Test mount points
    logger.info("Checking common mount points:")
    mount_points = ["/media/", "/mnt/"]
    for mp in mount_points:
        if os.path.exists(mp):
            contents = os.listdir(mp)
            logger.info(f"  {mp}: {contents}")
        else:
            logger.info(f"  {mp}: does not exist")

def update_usb_status():
    """Update USB drive status and LED - improved with debouncing"""
    global usb_drive_mounted
    
    try:
        usb_drives = find_usb_drives()
        new_status = len(usb_drives) > 0
        
        if new_status != usb_drive_mounted:
            usb_drive_mounted = new_status
            
            # Update LED immediately
            set_usb_led_brightness(100 if usb_drive_mounted else 0)
            
            if usb_drive_mounted:
                logger.info("USB drive detected, reloading sounds")
                logger.info(f"USB LED (GPIO {USB_LED_PIN}) should be ON")
                logger.info(f"USB paths: {usb_drives}")
                find_sound_files()
            else:
                logger.info("USB drive removed")
                logger.info(f"USB LED (GPIO {USB_LED_PIN}) should be OFF")
                
    except Exception as e:
        logger.error(f"Error updating USB status: {e}")
        # Ensure LED is off on error
        try:
            set_usb_led_brightness(0)
        except:
            pass

