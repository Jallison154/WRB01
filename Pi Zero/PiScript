def find_usb_drives():
    """Find mounted USB drives - improved detection"""
    usb_paths = []
    try:
        # Check /proc/mounts for actual mounted devices
        try:
            with open('/proc/mounts', 'r') as f:
                for line in f:
                    parts = line.split()
                    if len(parts) >= 2:
                        mount_point = parts[1]
                        device = parts[0]
                        # Check if it's a USB device (common patterns)
                        if (device.startswith('/dev/sd') and 
                            mount_point.startswith('/media/') and
                            os.path.isdir(mount_point) and 
                            os.access(mount_point, os.R_OK)):
                            usb_paths.append(mount_point)
        except Exception as e:
            logger.warning(f"Could not read /proc/mounts: {e}")
        
        # Fallback to glob patterns if /proc/mounts fails
        if not usb_paths:
            mount_points = [
                "/media/*/",
                "/mnt/usb*",
                "/media/usb*"
            ]
            
            for pattern in mount_points:
                for path in glob.glob(pattern):
                    if os.path.isdir(path) and os.access(path, os.R_OK):
                        usb_paths.append(path)
        
        if usb_paths:
            logger.info(f"Found USB drives: {usb_paths}")
        else:
            logger.debug("No USB drives found")
            
    except Exception as e:
        logger.error(f"Error finding USB drives: {e}")
    
    return usb_paths

def test_usb_detection():
    """Test USB detection and LED functionality"""
    logger.info("=== USB Detection Test ===")
    
    # Test GPIO LED
    try:
        logger.info("Testing USB LED (GPIO 24)...")
        set_usb_led_brightness(100)
