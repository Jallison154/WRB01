# SYSTEM MONITORING
# =============================================================================

def cleanup_finished_sounds():
    """Clean up tracking for sounds that have finished playing"""
    try:
        finished_sounds = []
        for sound_type, channel in active_sounds.items():
            if not channel.get_busy():
                finished_sounds.append(sound_type)
        
        for sound_type in finished_sounds:
            del active_sounds[sound_type]
            logger.debug(f"Cleaned up finished sound: {sound_type}")
            
    except Exception as e:
        logger.error(f"Error cleaning up finished sounds: {e}")

def system_monitor():
    """Monitor system status in a separate thread"""
    logger.info("System monitor started")
    
    try:
        while running:
            # Update USB status
            update_usb_status()
            
            # Clean up finished sounds
            cleanup_finished_sounds()
            
            # Log system status every 5 minutes
            if int(time.time()) % 300 == 0:
                logger.info(f"System running - ESP32: {'Connected' if esp32_connected else 'Disconnected'}, "
                          f"USB: {'Mounted' if usb_drive_mounted else 'Not mounted'}")
            
            time.sleep(1)
    except Exception as e:
        logger.error(f"System monitor error: {e}")

# =============================================================================
# SIGNAL HANDLING
# =============================================================================

def signal_handler(signum, frame):
    """Handle shutdown signals"""
    global running
    logger.info(f"Received signal {signum}, shutting down...")
    running = False

# =============================================================================
# MAIN APPLICATION
# =============================================================================

def main():
    """Main application entry point"""
    logger.info("=== WRB Enhanced Audio System Starting ===")
    
    # Setup signal handlers
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)
    
    
    # Initialize components
    if not setup_gpio():
        logger.error("GPIO setup failed, exiting")
        return 1
    
    if not setup_audio():
        logger.error("Audio setup failed, exiting")
        cleanup_gpio()
        return 1
    
    # Start monitoring threads immediately
    global serial_thread, monitor_thread
    serial_thread = threading.Thread(target=serial_monitor, daemon=True)
    monitor_thread = threading.Thread(target=system_monitor, daemon=True)
    
    serial_thread.start()
    monitor_thread.start()
    
    logger.info("WRB system ready and running")
    
    # Load sound files in background (non-blocking)
    threading.Thread(target=find_sound_files, daemon=True).start()
    
    # Test USB detection in background (non-blocking)
    threading.Thread(target=test_usb_detection, daemon=True).start()
    
    try:
        # Main loop
        while running:
            time.sleep(1)
    except KeyboardInterrupt:
        logger.info("Keyboard interrupt received")
    finally:
        # Cleanup
        running = False
        logger.info("Shutting down WRB system...")
        
        cleanup_audio()
        cleanup_gpio()
        
        logger.info("WRB system shutdown complete")
    
    return 0

if __name__ == "__main__":
    sys.exit(main())
