"""
WRB Enhanced Audio System - Main Application
Raspberry Pi ESP32 Wireless Button System

Features:
- Serial communication with ESP32 receiver
- Audio playback with 4-channel support
- GPIO LED control
- USB drive detection and mounting
- System monitoring and logging
- Error handling and recovery
"""

import serial
import pygame
import time
import threading
import logging
import os
import sys
import glob
import subprocess
import signal
from datetime import datetime
from pathlib import Path
import RPi.GPIO as GPIO
from config import *

# =============================================================================
# GLOBAL VARIABLES
# =============================================================================

# Audio mixer and channels
mixer = None
channels = {}
sound_files = {}
active_sounds = {}  # Track active sounds for fade-out

# GPIO pins
READY_PIN = 23
USB_LED_PIN = 24

# System state
running = True
usb_drive_mounted = False
esp32_connected = False
last_button_time = 0

# Threading
serial_thread = None
monitor_thread = None

# =============================================================================
# LOGGING SETUP
# =============================================================================

def setup_logging():
    """Setup logging configuration"""
    log_dir = Path.home() / "WRB" / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    
    logging.basicConfig(
        level=logging.INFO,
        format='%(asctime)s - %(levelname)s - %(message)s',
        handlers=[
            logging.FileHandler(log_dir / 'button_log.txt'),
            logging.StreamHandler(sys.stdout)
        ]
    )
    
    return logging.getLogger(__name__)

logger = setup_logging()

# =============================================================================
# GPIO SETUP
# =============================================================================

def setup_gpio():
    """Initialize GPIO pins"""
    try:
        GPIO.setmode(GPIO.BCM)
        GPIO.setup(READY_PIN, GPIO.OUT)
        GPIO.setup(USB_LED_PIN, GPIO.OUT)
        
        # Turn on ready LED
        GPIO.output(READY_PIN, GPIO.HIGH)
        logger.info("GPIO initialized successfully")
        logger.info(f"Ready LED (GPIO {READY_PIN}) should be ON")
        logger.info(f"USB LED (GPIO {USB_LED_PIN}) is OFF (no USB drive)")
        return True
    except Exception as e:
        logger.error(f"GPIO setup failed: {e}")
        logger.error("Make sure the script is running with proper permissions")
        logger.error("Try running with: sudo python3 PiScript")
        return False

def cleanup_gpio():
    """Clean up GPIO pins"""
    try:
        GPIO.cleanup()
        logger.info("GPIO cleaned up")
    except Exception as e:
        logger.error(f"GPIO cleanup failed: {e}")

# =============================================================================
# AUDIO SYSTEM
# =============================================================================

def setup_audio():
    """Initialize audio system"""
    global mixer, channels
    
    try:
        # Initialize pygame mixer
        pygame.mixer.pre_init(
            frequency=MIX_FREQ,
            size=-16,  # 16-bit signed
            channels=2,  # Stereo
            buffer=MIX_BUF
        )
        pygame.mixer.init()
        
        # Create 4 audio channels
        for i in range(4):
            channels[i] = pygame.mixer.Channel(i)
        
        logger.info("Audio system initialized successfully")
        return True
    except Exception as e:
        logger.error(f"Audio setup failed: {e}")
        return False

def cleanup_audio():
    """Clean up audio system"""
    try:
        # Fade out all active sounds before cleanup
        for sound_type in list(active_sounds.keys()):
            fade_out_sound(sound_type, 0.5)  # Quick fade-out
        
        # Wait a moment for fade-outs to complete
        time.sleep(0.6)
        
        pygame.mixer.quit()
        active_sounds.clear()
        logger.info("Audio system cleaned up")
    except Exception as e:
        logger.error(f"Audio cleanup failed: {e}")

def create_test_sound(frequency=440, duration=0.5):
    """Create a test sound for testing purposes"""
    try:
        import numpy as np
        
        sample_rate = MIX_FREQ
        frames = int(duration * sample_rate)
        arr = np.zeros((frames, 2))
        
        for i in range(frames):
            arr[i][0] = np.sin(2 * np.pi * frequency * i / sample_rate) * 0.3
            arr[i][1] = arr[i][0]
        
        arr = (arr * 32767).astype(np.int16)
        sound = pygame.sndarray.make_sound(arr)
        return sound
    except Exception as e:
        logger.error(f"Test sound creation failed: {e}")
        return None

# =============================================================================
# SOUND FILE MANAGEMENT
# =============================================================================

def find_sound_files():
    """Find and load sound files from USB drive and local directory"""
    global sound_files
    
    sound_files = {
        'button1': [],
        'button2': [],
        'hold1': [],
        'hold2': []
    }
    
    # Check USB drive first
    usb_paths = find_usb_drives()
    if usb_paths:
        for usb_path in usb_paths:
            load_sounds_from_path(usb_path, "USB")
    
    # Check local sounds directory
    local_sounds_dir = Path.home() / "WRB" / "sounds"
    if local_sounds_dir.exists():
        load_sounds_from_path(local_sounds_dir, "Local")
    
    # Load default sounds if no custom sounds found
    default_sounds_dir = Path(__file__).parent / "default_sounds"
    if default_sounds_dir.exists():
        load_sounds_from_path(default_sounds_dir, "Default")
    
    # Create test sounds if no sounds found at all
    if not any(sound_files.values()):
        logger.info("No sound files found, creating test sounds")
        create_default_sounds()
    
    # Log loaded sounds
    for sound_type, files in sound_files.items():
        logger.info(f"Loaded {len(files)} {sound_type} sounds")

def load_sounds_from_path(path, source):
    """Load sound files from a specific path"""
    try:
        path = Path(path)
        if not path.exists():
            return
        
        # Find WAV files matching patterns
        patterns = {
            'button1': 'button1*.wav',
            'button2': 'button2*.wav',
            'hold1': 'hold1*.wav',
            'hold2': 'hold2*.wav'
        }
        
        for sound_type, pattern in patterns.items():
            for file_path in path.glob(pattern):
                try:
                    sound = pygame.mixer.Sound(str(file_path))
                    sound_files[sound_type].append({
                        'sound': sound,
                        'file': str(file_path),
                        'source': source
                    })
                    logger.info(f"Loaded {sound_type} sound: {file_path.name} from {source}")
                except Exception as e:
                    logger.error(f"Failed to load sound {file_path}: {e}")
    except Exception as e:
        logger.error(f"Error loading sounds from {path}: {e}")

def create_default_sounds():
    """Create default test sounds"""
    try:
        # Create test sounds for each button type
        test_sounds = {
            'button1': create_test_sound(440, 0.3),  # A4 note
            'button2': create_test_sound(523, 0.3),  # C5 note
            'hold1': create_test_sound(659, 0.8),    # E5 note, longer
            'hold2': create_test_sound(784, 0.8),    # G5 note, longer
        }
        
        for sound_type, sound in test_sounds.items():
            if sound:
                sound_files[sound_type].append({
                    'sound': sound,
                    'file': f'Generated {sound_type} test sound',
                    'source': 'Generated'
                })
        
        logger.info("Created default test sounds")
    except Exception as e:
        logger.error(f"Failed to create default sounds: {e}")

def fade_out_sound(sound_type, fade_duration=1.0):
    """Fade out a currently playing sound over the specified duration"""
    try:
        if sound_type in active_sounds:
            channel = active_sounds[sound_type]
            if channel and channel.get_busy():
                logger.info(f"Fading out {sound_type} sound over {fade_duration}s")
                
                # Start fade-out in a separate thread
                fade_thread = threading.Thread(
                    target=fade_out_channel,
                    args=(channel, fade_duration),
                    daemon=True
                )
                fade_thread.start()
                
                # Remove from active sounds tracking
                del active_sounds[sound_type]
                return True
    except Exception as e:
        logger.error(f"Failed to fade out {sound_type} sound: {e}")
    
    return False

def fade_out_channel(channel, fade_duration):
    """Fade out a channel over the specified duration"""
    try:
        import time
        
        # Get current volume
        current_volume = channel.get_volume()
        steps = FADE_OUT_STEPS  # Number of fade steps from config
        step_duration = fade_duration / steps
        volume_step = current_volume / steps
        
        # Fade out gradually
        for i in range(steps):
            new_volume = max(0.0, current_volume - (volume_step * i))
            channel.set_volume(new_volume)
            time.sleep(step_duration)
            
            # Stop if channel is no longer playing
            if not channel.get_busy():
                break
        
        # Stop the channel completely
        channel.stop()
        
    except Exception as e:
        logger.error(f"Error during fade out: {e}")
        # Force stop the channel if fade fails
        try:
            channel.stop()
        except:
            pass

def play_sound(sound_type):
    """Play a random sound of the specified type with fade-out support"""
    try:
        if sound_type not in sound_files or not sound_files[sound_type]:
            logger.warning(f"No sounds available for {sound_type}")
            return
        
        # Check if the same sound type is already playing and fade it out
        if sound_type in active_sounds:
            fade_out_sound(sound_type, FADE_OUT_DURATION)  # Configurable fade-out
            time.sleep(0.1)  # Brief pause before starting new sound
        
        # Select a random sound
        import random
        sound_data = random.choice(sound_files[sound_type])
        sound = sound_data['sound']
        
        # Find an available channel
        selected_channel = None
        for channel_id, channel in channels.items():
            if not channel.get_busy():
                selected_channel = channel
                break
        
        # If no channel is available, use channel 0 (overwrite)
        if selected_channel is None:
            selected_channel = channels[0]
            # If channel 0 is busy, fade out any active sound on it
            if selected_channel.get_busy():
                for active_type, active_channel in list(active_sounds.items()):
                    if active_channel == selected_channel:
                        fade_out_sound(active_type, 0.5)  # Quick fade-out
                        break
        
        # Play the sound
        selected_channel.play(sound)
        selected_channel.set_volume(1.0)  # Ensure full volume
        
        # Track the active sound
        active_sounds[sound_type] = selected_channel
        
        logger.info(f"Playing {sound_type} sound from {sound_data['source']}")
        
    except Exception as e:
        logger.error(f"Failed to play {sound_type} sound: {e}")

# =============================================================================
# USB DRIVE DETECTION
# =============================================================================

def find_usb_drives():
    """Find mounted USB drives"""
    usb_paths = []
    try:
        # Common USB mount points
        mount_points = [
            "/media/*/",
            "/mnt/usb*",
            "/media/usb*"
        ]
        
        for pattern in mount_points:
            for path in glob.glob(pattern):
                if os.path.isdir(path) and os.access(path, os.R_OK):
                    usb_paths.append(path)
        
        if usb_paths:
            logger.info(f"Found USB drives: {usb_paths}")
        else:
            logger.info("No USB drives found")
            
    except Exception as e:
        logger.error(f"Error finding USB drives: {e}")
    
    return usb_paths

def update_usb_status():
    """Update USB drive status and LED"""
    global usb_drive_mounted
    
    usb_drives = find_usb_drives()
    new_status = len(usb_drives) > 0
    
    if new_status != usb_drive_mounted:
        usb_drive_mounted = new_status
        GPIO.output(USB_LED_PIN, GPIO.HIGH if usb_drive_mounted else GPIO.LOW)
        
        if usb_drive_mounted:
            logger.info("USB drive detected, reloading sounds")
            logger.info(f"USB LED (GPIO {USB_LED_PIN}) should be ON")
            find_sound_files()
        else:
            logger.info("USB drive removed")
            logger.info(f"USB LED (GPIO {USB_LED_PIN}) should be OFF")

# =============================================================================
# SERIAL COMMUNICATION
# =============================================================================

def find_serial_port():
    """Find the ESP32 serial port"""
    possible_ports = [
        "/dev/ttyACM0",
        "/dev/ttyACM1", 
        "/dev/ttyUSB0",
        "/dev/ttyUSB1"
    ]
    
    for port in possible_ports:
        if os.path.exists(port):
            try:
                # Try to open the port to verify it's accessible
                test_serial = serial.Serial(port, 115200, timeout=1)
                test_serial.close()
                logger.info(f"Found ESP32 on port: {port}")
                return port
            except Exception as e:
                logger.debug(f"Port {port} not accessible: {e}")
                continue
    
    logger.warning("No ESP32 serial port found")
    return None

def setup_serial():
    """Initialize serial communication with ESP32"""
    port = find_serial_port()
    if not port:
        return None
    
    try:
        ser = serial.Serial(
            port=port,
            baudrate=BAUD,
            timeout=1,
            write_timeout=1
        )
        
        # Wait for ESP32 to initialize
        time.sleep(2)
        
        logger.info(f"Serial communication established on {port}")
        return ser
    except Exception as e:
        logger.error(f"Serial setup failed: {e}")
        return None

def process_serial_message(message):
    """Process incoming serial message from ESP32"""
    global last_button_time
    
    message = message.strip()
    current_time = time.time()
    
    # Debounce button presses
    if current_time - last_button_time < BUTTON_DEBOUNCE_TIME:
        return
    
    last_button_time = current_time
    
    # Process button messages
    if message == "BTN1":
        logger.info("Button 1 pressed")
        play_sound('button1')
    elif message == "BTN2":
        logger.info("Button 2 pressed")
        play_sound('button2')
    elif message == "HOLD1":
        logger.info("Button 1 hold")
        play_sound('hold1')
    elif message == "HOLD2":
        logger.info("Button 2 hold")
        play_sound('hold2')
    else:
        logger.debug(f"Unknown message: {message}")

def serial_monitor():
    """Monitor serial communication in a separate thread"""
    global esp32_connected
    
    ser = setup_serial()
    if not ser:
        logger.error("Failed to establish serial connection")
        return
    
    esp32_connected = True
    logger.info("Serial monitor started")
    
    try:
        while running:
            try:
                if ser.in_waiting > 0:
                    message = ser.readline().decode('utf-8', errors='ignore')
                    if message:
                        process_serial_message(message)
                else:
                    time.sleep(0.01)
            except Exception as e:
                logger.error(f"Serial read error: {e}")
                time.sleep(1)
    except Exception as e:
        logger.error(f"Serial monitor error: {e}")
    finally:
        esp32_connected = False
        if ser:
            ser.close()

# =============================================================================
# SYSTEM MONITORING
# =============================================================================

def cleanup_finished_sounds():
    """Clean up tracking for sounds that have finished playing"""
    try:
        finished_sounds = []
        for sound_type, channel in active_sounds.items():
            if not channel.get_busy():
                finished_sounds.append(sound_type)
        
        for sound_type in finished_sounds:
            del active_sounds[sound_type]
            logger.debug(f"Cleaned up finished sound: {sound_type}")
            
    except Exception as e:
        logger.error(f"Error cleaning up finished sounds: {e}")

def system_monitor():
    """Monitor system status in a separate thread"""
    logger.info("System monitor started")
    
    try:
        while running:
            # Update USB status
            update_usb_status()
            
            # Clean up finished sounds
            cleanup_finished_sounds()
            
            # Log system status every 5 minutes
            if int(time.time()) % 300 == 0:
                logger.info(f"System running - ESP32: {'Connected' if esp32_connected else 'Disconnected'}, "
                          f"USB: {'Mounted' if usb_drive_mounted else 'Not mounted'}")
            
            time.sleep(1)
    except Exception as e:
        logger.error(f"System monitor error: {e}")

# =============================================================================
# SIGNAL HANDLING
# =============================================================================

def signal_handler(signum, frame):
    """Handle shutdown signals"""
    global running
    logger.info(f"Received signal {signum}, shutting down...")
    running = False

# =============================================================================
# MAIN APPLICATION
# =============================================================================

def main():
    """Main application entry point"""
    logger.info("=== WRB Enhanced Audio System Starting ===")
    
    # Setup signal handlers
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)
    
    # Initialize components
    if not setup_gpio():
        logger.error("GPIO setup failed, exiting")
        return 1
    
    if not setup_audio():
        logger.error("Audio setup failed, exiting")
        cleanup_gpio()
        return 1
    
    # Load sound files
    find_sound_files()
    
    # Start monitoring threads
    global serial_thread, monitor_thread
    serial_thread = threading.Thread(target=serial_monitor, daemon=True)
    monitor_thread = threading.Thread(target=system_monitor, daemon=True)
    
    serial_thread.start()
    monitor_thread.start()
    
    logger.info("WRB system ready and running")
    
    try:
        # Main loop
        while running:
            time.sleep(1)
    except KeyboardInterrupt:
        logger.info("Keyboard interrupt received")
    finally:
        # Cleanup
        running = False
        logger.info("Shutting down WRB system...")
        
        cleanup_audio()
        cleanup_gpio()
        
        logger.info("WRB system shutdown complete")
    
    return 0

if __name__ == "__main__":
    sys.exit(main())
