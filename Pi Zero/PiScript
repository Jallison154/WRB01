def setup_gpio():
    """Initialize GPIO pins with PWM support"""
    if not GPIO_AVAILABLE:
        logger.warning("GPIO not available, LED control disabled")
        return True
        
    try:
        GPIO.setmode(GPIO.BCM)
        GPIO.setup(READY_PIN, GPIO.OUT)
        GPIO.setup(USB_LED_PIN, GPIO.OUT)
        
        # Try to initialize PWM for LEDs
        global ready_pwm, usb_pwm
        try:
            ready_pwm = GPIO.PWM(READY_PIN, 1000)  # 1kHz frequency
            usb_pwm = GPIO.PWM(USB_LED_PIN, 1000)
            
            # Start PWM
            ready_pwm.start(0)  # Start at 0% duty cycle
            usb_pwm.start(0)
            
            # Set ready LED to 25% brightness
            set_ready_led_brightness(25)
            
            logger.info("GPIO initialized successfully with PWM support")
            logger.info(f"Ready LED (GPIO {READY_PIN}) set to 25% brightness")
            logger.info(f"USB LED (GPIO {USB_LED_PIN}) is OFF (no USB drive)")
            return True
            
        except Exception as pwm_error:
            logger.warning(f"PWM setup failed: {pwm_error}")
            logger.info("Falling back to simple GPIO control")
            
            # Fallback to simple GPIO control
            ready_pwm = None
            usb_pwm = None
            GPIO.output(READY_PIN, GPIO.HIGH)  # Turn on ready LED
            GPIO.output(USB_LED_PIN, GPIO.LOW)  # Turn off USB LED
            
            logger.info("GPIO initialized with simple on/off control")
            logger.info(f"Ready LED (GPIO {READY_PIN}) is ON")
            logger.info(f"USB LED (GPIO {USB_LED_PIN}) is OFF")
            return True
            
    except Exception as e:
        logger.error(f"GPIO setup failed: {e}")
        logger.error("Make sure the script is running with proper permissions")
        logger.error("Try running with: sudo python3 PiScript")
        return False

def set_ready_led_brightness(brightness):
    """Set ready LED brightness (0-100%)"""
    if not GPIO_AVAILABLE:
        return
        
    try:
        if ready_pwm:
            ready_pwm.ChangeDutyCycle(brightness)
        else:
            # Fallback to simple on/off
            GPIO.output(READY_PIN, GPIO.HIGH if brightness > 0 else GPIO.LOW)
    except Exception as e:
        logger.error(f"Failed to set ready LED brightness: {e}")

def set_usb_led_brightness(brightness):
    """Set USB LED brightness (0-100%)"""
    if not GPIO_AVAILABLE:
        return
        
    try:
        if usb_pwm:
            usb_pwm.ChangeDutyCycle(brightness)
        else:
            # Fallback to simple on/off
            GPIO.output(USB_LED_PIN, GPIO.HIGH if brightness > 0 else GPIO.LOW)
    except Exception as e:
        logger.error(f"Failed to set USB LED brightness: {e}")

def flash_ready_led():
    """Flash ready LED at 100% for 200ms when audio is triggered"""
    if not GPIO_AVAILABLE:
        return
        
    try:
        if ready_pwm:
            # Flash to 100% brightness
            ready_pwm.ChangeDutyCycle(100)
            time.sleep(0.2)  # 200ms flash
            # Return to 25% brightness
            ready_pwm.ChangeDutyCycle(25)
        else:
            # Fallback: simple flash
            GPIO.output(READY_PIN, GPIO.LOW)  # Flash off
            time.sleep(0.1)
            GPIO.output(READY_PIN, GPIO.HIGH)  # Flash on
            time.sleep(0.2)
            GPIO.output(READY_PIN, GPIO.HIGH)  # Keep on
    except Exception as e:
        logger.error(f"Failed to flash ready LED: {e}")

def cleanup_gpio():
    """Clean up GPIO pins"""
    if not GPIO_AVAILABLE:
        return
        
    try:
        # Stop PWM before cleanup
        if ready_pwm:
            ready_pwm.stop()
        if usb_pwm:
            usb_pwm.stop()
        GPIO.cleanup()
        logger.info("GPIO cleaned up")
    except Exception as e:
        logger.error(f"GPIO cleanup failed: {e}")

